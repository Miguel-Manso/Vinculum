# ============================================================================
# Vinculum — variáveis de ambiente do backend
# Copie para backend/.env e preencha. NUNCA envie o .env para o GitHub.
# Em produção (Render), cadastre estas variáveis no painel "Environment".
# ============================================================================

PORT=3000

# Chave que assina os logins. Obrigatória em produção: mínimo 32 caracteres,
# aleatória e só sua (o servidor não inicia em produção com chave fraca).
# Gere com:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=8h

# ---------------------------------------------------------------------------
# Banco de dados — use UMA das opções
# ---------------------------------------------------------------------------
# Opção 1 (recomendada para nuvem): PostgreSQL (Neon / Supabase)
DATABASE_URL=postgresql://usuario:senha@host/banco?sslmode=require

# Opção 2: SQL Server (usada quando DATABASE_URL não está definida)
# DB_SERVER=localhost\SQLEXPRESS
# DB_PORT=1433
# DB_DATABASE=vinculum
# DB_USER=
# DB_PASSWORD=

# ---------------------------------------------------------------------------
# Assistente com I.A. (opcional — sem chave, o chat funciona em "modo básico")
# ---------------------------------------------------------------------------
# Gemini (plano gratuito): crie em https://aistudio.google.com → API keys
GEMINI_API_KEY=
# GEMINI_MODEL=            # opcional: força um modelo (padrão: escolha automática)

# Claude (pago): https://console.anthropic.com
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-5-5
# IA_PROVEDOR=gemini       # se as duas chaves existirem: "gemini" ou "anthropic"

# Limite de perguntas ao assistente por usuário
# CHAT_LIMITE_MINUTO=10
# CHAT_LIMITE_DIA=150

# ---------------------------------------------------------------------------
# Outros
# ---------------------------------------------------------------------------
# Sites extras que podem chamar a API (vinculumflow.com.br, a Vercel e
# localhost já são liberados por padrão). Separe por vírgula.
# CORS_ORIGINS=https://outro-dominio.com.br

# Fuso usado para "hoje", "atrasada" etc. no assistente
# APP_TZ=America/Sao_Paulo
